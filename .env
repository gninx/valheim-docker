SERVER_NAME=Public Server Name
SERVER_PORT=2456
WORLD_NAME=worldname
SERVER_PASS=password
SERVER_PUBLIC=true
CROSSPLAY=true
SERVER_ARGS=-modifier portals casual -modifier raids none
ADMINLIST_IDS= #(space separated list of steamIDs)
UPDATE_CRON=*/15 * * * *
UPDATE_IF_IDLE=true
RESTART_CRON=0 5 * * *
RESTART_IF_IDLE=true
TZ=America/Chicago
BACKUPS=true
BACKUPS_CRON=0 * * * *
BACKUPS_DIRECTORY=/backups
BACKUPS_MAX_AGE=3
BACKUPS_MAX_COUNT=0
BACKUPS_IF_IDLE=true
BACKUPS_IDLE_GRACE_PERIOD=3600
PERMISSIONS_UMASK=022
STEAMCMD_ARGS=validate
PUID=1000
PGID=1000
DISCORD_WEBHOOK=#paste your discord webhook here - https://www.svix.com/resources/guides/how-to-make-webhook-discord/
VALHEIM_LOG_FILTER_CONTAINS_Spawned=Got character ZDOID from
ON_VALHEIM_LOG_FILTER_CONTAINS_Spawned='{ read l; l=${l//*ZDOID from /}; l=${l// :*/}; msg="Player $l spawned"; curl -sfSL -X POST -H "Content-Type: application/json" -d "{\"username\":\"Valheim\",\"content\":\"$msg\"}" "$DISCORD_WEBHOOK"; }'
